# Django Settings
SECRET_KEY=django-insecure-insurance-survey-dev-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (dev defaults to sqlite if not set; prod requires PostgreSQL URL)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/insurance_survey_db
